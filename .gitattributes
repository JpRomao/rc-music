* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.psd1 text eol=lf
*.psm1 text eol=lf
*.sha256 text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
scripts/fixtures/*.py text eol=lf
extensions/chromium/main/* text eol=lf
tests/extensions/*.mjs text eol=lf
tests/qt/network-fixtures/*.pem text eol=lf
*.bin binary
*.flac binary
*.m4a binary
*.mp3 binary
*.ogg binary
*.opus binary
*.wav binary
LICENSE* text eol=lf
docs/delivery/licenses/* -text
# Preserve terminal blank lines present in these unmodified upstream documents.
docs/delivery/licenses/Qtbase-freetype-LICENSE.txt whitespace=-blank-at-eof
docs/delivery/licenses/Qtbase-zlib-LICENSE.txt whitespace=-blank-at-eof
docs/delivery/licenses/TagLib-COPYING.MPL.txt whitespace=-blank-at-eof
packaging/windows/*.nsi text eol=lf
packaging/windows/*.nsh text eol=lf
packaging/windows/LOCAL-DEVELOPMENT.txt text eol=lf
packaging/windows/notices/*/* -text
packaging/windows/notices/*/NOTICE.txt text eol=lf
packaging/windows/notices/qt-multimedia/TLSF-LICENSE.txt whitespace=-blank-at-eol
packaging/windows/notices/qtbase/Qtbase-freetype-LICENSE.txt whitespace=-blank-at-eof
packaging/windows/notices/qtbase/Qtbase-zlib-LICENSE.txt whitespace=-blank-at-eof
packaging/windows/notices/taglib/TagLib-COPYING.MPL.txt whitespace=-blank-at-eof
tools/download-runtime/notices/* -text
packaging/windows/qt.conf text eol=lf
experiments/m0/candidates/qt/package-v2/PACKAGE-LIMITATIONS.txt text eol=lf
experiments/m0/candidates/qt/package-v2/qt.conf text eol=lf
