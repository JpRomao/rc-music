cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED BUILD_DIRECTORY OR NOT DEFINED NINJA_COMMAND OR
   NOT DEFINED NATIVE_INGRESS_EXPECTED OR NOT DEFINED COMPOSITION_TEST_AVAILABLE)
    message(FATAL_ERROR "Player ingress boundary requires a build, Ninja and explicit expected profiles")
endif()
if(NOT NATIVE_INGRESS_EXPECTED STREQUAL "ON" AND NOT NATIVE_INGRESS_EXPECTED STREQUAL "OFF")
    message(FATAL_ERROR "Player ingress expectation must be ON or OFF")
endif()

function(commands target output)
    execute_process(COMMAND "${NINJA_COMMAND}" -C "${BUILD_DIRECTORY}" -t commands "${target}"
        RESULT_VARIABLE status OUTPUT_VARIABLE graph ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR graph STREQUAL "")
        message(FATAL_ERROR "Cannot inspect ${target} command closure: ${error}")
    endif()
    string(REPLACE "\\" "/" graph "${graph}")
    set(${output} "${graph}" PARENT_SCOPE)
endfunction()

function(compilation graph source output)
    string(REPLACE ";" "\\;" lines "${graph}")
    string(REPLACE "\n" ";" lines "${lines}")
    set(count 0)
    set(found "")
    foreach(line IN LISTS lines)
        if(line MATCHES " /Fo" AND NOT line MATCHES "scanDependencies" AND
           line MATCHES "/${source}[.]cpp([ \"\r]|$)")
            math(EXPR count "${count} + 1")
            set(found "${line}")
        endif()
    endforeach()
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one ${source} compilation; found ${count}")
    endif()
    set(${output} "${found}" PARENT_SCOPE)
endfunction()

set(native_components "rc_music_native_messaging[.]lib|QtNative(Download|YoutubeAudio)|WindowsNative(Download|Messaging|HostWatchdog)")
set(owner_macro "[-/]DRC_MUSIC_PLAYER_NATIVE_INGRESS_AVAILABLE(=1)?( |$)")
set(test_macro "[-/]DRC_MUSIC_TEST_PLAYER_NATIVE_INGRESS(=1)?( |$)")
set(scenario_macro "[-/]DRC_MUSIC_ENABLE_FIXTURE_SCENARIOS(=1)?( |$)")
foreach(ui IN ITEMS m0_qt_shell_ui rc_music_test_ui)
    commands("${ui}" graph)
    if(graph MATCHES "${native_components}|RC_MUSIC_PLAYER_NATIVE_INGRESS_AVAILABLE|RC_MUSIC_TEST_PLAYER_NATIVE_INGRESS|youtube-owner-native-host")
        message(FATAL_ERROR "${ui} acquired the owner-only Native Messaging dependency or compile profile")
    endif()
endforeach()
commands(rc_music_core core_graph)
if(core_graph MATCHES "${native_components}|Qt6|QT_CORE_LIB|RC_MUSIC_PLAYER_NATIVE_INGRESS_AVAILABLE|RC_MUSIC_TEST_PLAYER_NATIVE_INGRESS")
    message(FATAL_ERROR "The pure core acquired Qt, Native Messaging or an owner compile profile")
endif()

foreach(owner IN ITEMS rc_music_player_downloads rc_music_test_player_downloads)
    commands("${owner}" graph)
    compilation("${graph}" WindowsPlayerDownloads owner_compilation)
    if(owner STREQUAL "rc_music_player_downloads")
        set(required_ui m0_qt_shell_ui)
        set(forbidden_ui rc_music_test_ui)
        if(graph MATCHES "RC_MUSIC_ENABLE_FIXTURE_SCENARIOS")
            message(FATAL_ERROR "Production player owner reaches the scenario ABI")
        endif()
    else()
        set(required_ui rc_music_test_ui)
        set(forbidden_ui m0_qt_shell_ui)
        if(NOT owner_compilation MATCHES "${scenario_macro}")
            message(FATAL_ERROR "Test player owner is not compiled with its matching scenario ABI")
        endif()
    endif()
    if(NOT graph MATCHES "${required_ui}[.]lib" OR graph MATCHES "${forbidden_ui}[.]lib")
        message(FATAL_ERROR "${owner} does not depend on exactly its own UI ABI")
    endif()
    if(owner_compilation MATCHES "${test_macro}")
        message(FATAL_ERROR "A test-consumer macro leaked into the owner library")
    endif()
    if(NATIVE_INGRESS_EXPECTED STREQUAL "ON")
        if(NOT owner_compilation MATCHES "${owner_macro}" OR NOT graph MATCHES "rc_music_native_messaging[.]lib")
            message(FATAL_ERROR "${owner} lacks its optional private Native Messaging composition")
        endif()
    elseif(owner_compilation MATCHES "${owner_macro}" OR graph MATCHES "${native_components}")
        message(FATAL_ERROR "${owner} acquired Native Messaging while that component is OFF")
    endif()
endforeach()

set(consumers rc_music_ui_player_downloads_tests)
if(COMPOSITION_TEST_AVAILABLE)
    list(APPEND consumers rc_music_player_downloads_composition_tests)
endif()
foreach(consumer IN LISTS consumers)
    commands("${consumer}" graph)
    if(consumer STREQUAL "rc_music_ui_player_downloads_tests")
        compilation("${graph}" WindowsPlayerDownloadsTests consumer_compilation)
        if(NOT consumer_compilation MATCHES "${scenario_macro}")
            message(FATAL_ERROR "The owner unit test lost its scenario UI ABI")
        endif()
    else()
        compilation("${graph}" PlayerDownloadsCompositionTests consumer_compilation)
        if(consumer_compilation MATCHES "${scenario_macro}")
            message(FATAL_ERROR "The production owner composition test acquired the scenario UI ABI")
        endif()
    endif()
    if(consumer_compilation MATCHES "${owner_macro}")
        message(FATAL_ERROR "The owner-only Native Messaging macro leaked into its consumer")
    endif()
    if(NATIVE_INGRESS_EXPECTED STREQUAL "ON")
        if(NOT consumer_compilation MATCHES "${test_macro}")
            message(FATAL_ERROR "Native owner tests are missing their explicit test-only profile")
        endif()
    elseif(consumer_compilation MATCHES "${test_macro}")
        message(FATAL_ERROR "Native owner test profile is enabled while Native Messaging is OFF")
    endif()
endforeach()
message(STATUS "Player Native ingress stays private to one-ABI owners; UI/core/default OFF remain isolated")
