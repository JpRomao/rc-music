cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED BUILD_DIRECTORY OR NOT DEFINED NINJA_COMMAND)
    message(FATAL_ERROR "Process boundary requires BUILD_DIRECTORY and NINJA_COMMAND")
endif()
cmake_path(ABSOLUTE_PATH BUILD_DIRECTORY NORMALIZE OUTPUT_VARIABLE build_root)

function(require_product_graph graph graph_build_root)
    # Generated paths may live in out/product/tests/desktop. Remove only the
    # absolute build prefix; source paths and test-generated tails remain.
    string(REPLACE "${graph_build_root}" "<build>" graph "${graph}")
    if(graph MATCHES "RC_MUSIC_ENABLE_FIXTURE_SCENARIOS|M0_QT_SHELL_TEST_HOOKS|RC_MUSIC_TEST_UI_VARIANT|RC_MUSIC_DOWNLOAD_SMOKE_AVAILABLE|DownloadsShellSmoke|/tests/|fixture_data|FixtureRepository|DeterministicPlaybackBackend|rc_music_test_ui|rc_music_test_support|rc_music_ui_scenario_support")
        message(FATAL_ERROR "Real application reaches a test hook, scenario or test support")
    endif()
endfunction()

function(require_product_resource resource resource_build_root)
    string(REPLACE "${resource_build_root}" "<build>" inspected_resource "${resource}")
    if(inspected_resource MATCHES "/tests/|[.]json$")
        message(FATAL_ERROR "Real application embeds a test/JSON resource: ${resource}")
    endif()
endfunction()

function(require_compilation graph source scenarios)
    string(REPLACE ";" "\\;" lines "${graph}")
    string(REPLACE "\n" ";" lines "${lines}")
    set(count 0)
    foreach(line IN LISTS lines)
        if(line MATCHES " /Fo" AND NOT line MATCHES "scanDependencies"
                AND line MATCHES "/${source}[.]cpp([ \"\r]|$)")
            math(EXPR count "${count} + 1")
            if(scenarios AND NOT line MATCHES "[-/]DRC_MUSIC_ENABLE_FIXTURE_SCENARIOS(=1)?( |$)")
                message(FATAL_ERROR "Scenario ABI macro missing from ${source}")
            endif()
            set(compilation_line "${line}" PARENT_SCOPE)
        endif()
    endforeach()
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one compilation of ${source}; found ${count}")
    endif()
endfunction()

function(inspect_resources graph target)
    string(REPLACE ";" "\\;" lines "${graph}")
    string(REPLACE "\n" ";" lines "${lines}")
    set(qrc_files)
    foreach(line IN LISTS lines)
        # --list is dependency discovery, not a resource compilation.
        if(line MATCHES "rcc[.]exe" AND NOT line MATCHES " --list([ =\"]|$)")
            string(REGEX MATCHALL "\"[A-Za-z]:/[^\"]+[.]qrc\"|[A-Za-z]:/[^ \"]+[.]qrc" inputs "${line}")
            if(NOT inputs)
                message(FATAL_ERROR "Cannot identify the compiled QRC for ${target}")
            endif()
            foreach(input IN LISTS inputs)
                string(REPLACE "\"" "" input "${input}")
                list(APPEND qrc_files "${input}")
            endforeach()
        endif()
    endforeach()
    if(NOT qrc_files)
        message(FATAL_ERROR "No compiled QRC is reachable from ${target}")
    endif()
    list(REMOVE_DUPLICATES qrc_files)
    set(json_files)
    foreach(qrc IN LISTS qrc_files)
        cmake_path(IS_PREFIX build_root "${qrc}" NORMALIZE inside_build)
        if(NOT inside_build OR NOT EXISTS "${qrc}")
            message(FATAL_ERROR "Expected a generated QRC inside the build: ${qrc}")
        endif()
        file(READ "${qrc}" content)
        string(REPLACE "\\" "/" content "${content}")
        string(REGEX MATCHALL "<file[^>]*>[^<]+</file>" entries "${content}")
        if(NOT entries)
            message(FATAL_ERROR "Cannot inspect generated QRC entries: ${qrc}")
        endif()
        foreach(entry IN LISTS entries)
            string(REGEX REPLACE "^<file[^>]*>([^<]+)</file>$" "\\1" resource "${entry}")
            if(target STREQUAL "m0_qt_shell")
                require_product_resource("${resource}" "${build_root}")
                foreach(layout IN ITEMS desktop-tests tests/desktop)
                    set(regression_root "${build_root}/${layout}")
                    string(REPLACE "${build_root}" "${regression_root}" remapped_resource "${resource}")
                    require_product_resource("${remapped_resource}" "${regression_root}")
                endforeach()
            endif()
            if(resource MATCHES "[.]json$")
                list(APPEND json_files "${resource}")
            endif()
        endforeach()
    endforeach()
    list(LENGTH json_files json_count)
    if(target STREQUAL "rc_music_fixture_test_shell")
        list(SORT json_files)
        if(NOT json_count EQUAL 2 OR NOT "${json_files}" MATCHES "/tests/ui/fixtures/fixture[.]v1[.]json;[^;]+/tests/ui/fixtures/queue[.]v1[.]json$")
            message(FATAL_ERROR "Fixture shell must embed exactly its two owned fixture JSON files")
        endif()
    elseif(NOT json_count EQUAL 0)
        message(FATAL_ERROR "${target} must not embed fixture/JSON resources")
    endif()
endfunction()

foreach(target IN ITEMS m0_qt_shell rc_music_test_shell rc_music_fixture_test_shell)
    execute_process(COMMAND "${NINJA_COMMAND}" -C "${build_root}" -t commands "${target}"
        RESULT_VARIABLE status OUTPUT_VARIABLE graph ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR graph STREQUAL "")
        message(FATAL_ERROR "Cannot inspect ${target} command closure: ${error}")
    endif()
    string(REPLACE "\\" "/" graph "${graph}")
    if(target STREQUAL "m0_qt_shell")
        require_product_graph("${graph}" "${build_root}")
        # Output paths accepted by the runner are not test-source references.
        # Exercise these names even when the actual build has a custom name.
        foreach(layout IN ITEMS desktop-tests tests/desktop)
            set(regression_root "${build_root}/${layout}")
            string(REPLACE "${build_root}" "${regression_root}" remapped_graph "${graph}")
            require_product_graph("${remapped_graph}" "${regression_root}")
        endforeach()
        set(ui m0_qt_shell_ui)
        set(scenarios OFF)
    else()
        if(graph MATCHES "m0_qt_shell_ui[.]lib|m0_qt_shell_ui_qmltyperegistrations|m0_qt_shell_uiplugin|m0_qt_diagnostic_binding[.]lib")
            message(FATAL_ERROR "${target} reaches the production UI/plugin or diagnostic binding")
        endif()
        set(ui rc_music_test_ui)
        set(scenarios ON)
    endif()
    foreach(library IN ITEMS "${ui}" "${ui}plugin")
        if(NOT graph MATCHES "${library}[.]lib")
            message(FATAL_ERROR "${target} is missing its exclusive ${library}")
        endif()
    endforeach()
    require_compilation("${graph}" "main" "${scenarios}")
    if(scenarios)
        foreach(macro IN ITEMS M0_QT_SHELL_TEST_HOOKS RC_MUSIC_TEST_UI_VARIANT)
            if(NOT compilation_line MATCHES "[-/]D${macro}(=1)?( |$)")
                message(FATAL_ERROR "${target} main.cpp is missing ${macro}")
            endif()
        endforeach()
    endif()
    if(target STREQUAL "rc_music_fixture_test_shell")
        if(graph MATCHES "M0_QT_COMBINED_AUDIO" OR NOT graph MATCHES "fixture_data")
            message(FATAL_ERROR "Fixture shell requires fixture data and must not enable combined audio")
        endif()
    elseif(NOT compilation_line MATCHES "[-/]DM0_QT_COMBINED_AUDIO(=1)?( |$)" OR graph MATCHES "fixture_data")
        message(FATAL_ERROR "${target} requires combined audio without fixture data")
    endif()
    require_compilation("${graph}" "PlayerPresenter" "${scenarios}")
    require_compilation("${graph}" "[^ /]+_qmltyperegistrations" "${scenarios}")
    require_compilation("${graph}" "${ui}_autogen/mocs_compilation" "${scenarios}")
    require_compilation("${graph}" "ShellDiagnosticBinding" "${scenarios}")
    inspect_resources("${graph}" "${target}")
endforeach()
message(STATUS "Real, combined-test and fixture-test process command closures are isolated")
