cmake_minimum_required(VERSION 3.31)
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(DEFINED NATIVE_YOUTUBE_CONFIG_CASE)
    include("${source_root}/cmake/RcMusicNativeMessaging.cmake")
    set(main_origin "chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/")
    set(main_endpoint "rc-music-main")
    set(youtube_origin "chrome-extension://bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/")
    set(youtube_endpoint "rc-music-youtube")
    if(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "disabled")
        set(main_origin "")
        set(main_endpoint "")
        set(youtube_origin "")
        set(youtube_endpoint "")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "main-only")
        set(youtube_origin "")
        set(youtube_endpoint "")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "youtube-only")
        set(main_origin "")
        set(main_endpoint "")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "endpoint96")
        string(REPEAT "x" 96 youtube_endpoint)
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "distinct")
        # The two complete, separate trusted profiles are valid.
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "origin-only")
        set(youtube_endpoint "")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "endpoint-only")
        set(youtube_origin "")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "web-origin")
        set(youtube_origin "https://www.youtube.com/")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "short-id")
        set(youtube_origin "chrome-extension://bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "invalid-alphabet")
        set(youtube_origin "chrome-extension://qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq/")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "uppercase-origin")
        set(youtube_origin "chrome-extension://BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB/")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "origin-suffix")
        string(APPEND youtube_origin "popup.html")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "endpoint-path")
        set(youtube_endpoint "rc/music/youtube")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "endpoint-dot")
        set(youtube_endpoint "rc.music.youtube")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "endpoint97")
        string(REPEAT "x" 97 youtube_endpoint)
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "same-origin")
        set(youtube_origin "${main_origin}")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "same-endpoint")
        set(youtube_endpoint "${main_endpoint}")
    elseif(NATIVE_YOUTUBE_CONFIG_CASE STREQUAL "case-alias-endpoint")
        string(TOUPPER "${main_endpoint}" youtube_endpoint)
    else()
        message(FATAL_ERROR "Unknown closed configuration test case")
    endif()
    rc_music_validate_native_messaging_identities("${main_origin}" "${main_endpoint}"
        "${youtube_origin}" "${youtube_endpoint}")
    return()
endif()

set(failures "")
set(valid_cases disabled main-only youtube-only distinct endpoint96)
set(invalid_cases origin-only endpoint-only web-origin short-id invalid-alphabet uppercase-origin origin-suffix
    endpoint-path endpoint-dot endpoint97 same-origin same-endpoint case-alias-endpoint)
foreach(case IN LISTS valid_cases invalid_cases)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DNATIVE_YOUTUBE_CONFIG_CASE=${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case IN_LIST valid_cases)
        if(NOT status STREQUAL "0")
            list(APPEND failures "valid profile refused: ${case}")
        endif()
    elseif(status STREQUAL "0")
        list(APPEND failures "invalid profile admitted: ${case}")
    endif()
endforeach()
if(failures)
    list(JOIN failures "\n" failure_text)
    message(FATAL_ERROR "${failure_text}")
endif()
message(STATUS "Native YouTube identity defaults, grammar and separation are valid")
