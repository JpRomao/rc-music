cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED BUILD_DIRECTORY OR NOT DEFINED CTEST_COMMAND)
    message(FATAL_ERROR "Audio registration requires the configured build and CTest")
endif()
execute_process(COMMAND "${CTEST_COMMAND}" --test-dir "${BUILD_DIRECTORY}"
    --show-only=json-v1 -R "^rc_music[.]metadata[.]"
    RESULT_VARIABLE status OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot read metadata test registration: ${error}")
endif()
string(JSON count LENGTH "${inventory}" tests)
if(count EQUAL 0)
    message(FATAL_ERROR "Metadata test registration is empty")
endif()
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    string(JSON property_count LENGTH "${inventory}" tests ${index} properties)
    math(EXPR property_last "${property_count} - 1")
    set(audio_label OFF)
    foreach(property_index RANGE ${property_last})
        string(JSON name GET "${inventory}" tests ${index} properties ${property_index} name)
        if(name STREQUAL "LABELS")
            string(JSON labels GET "${inventory}" tests ${index} properties ${property_index} value)
            if(labels MATCHES "\"audio\"")
                set(audio_label ON)
            endif()
        endif()
    endforeach()
    if(NOT audio_label)
        message(FATAL_ERROR "Metadata test must belong to the audio label")
    endif()
endforeach()
message(STATUS "All ${count} metadata tests belong to the audio selection")
