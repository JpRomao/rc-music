cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED BUILD_DIRECTORY OR NOT DEFINED NINJA_COMMAND)
    message(FATAL_ERROR "UI boundary requires BUILD_DIRECTORY and NINJA_COMMAND")
endif()

function(require_compilation graph source macro_required)
    string(REPLACE ";" "\\;" lines "${graph}")
    string(REPLACE "\n" ";" lines "${lines}")
    set(count 0)
    foreach(line IN LISTS lines)
        if(line MATCHES " /Fo" AND NOT line MATCHES "scanDependencies"
                AND line MATCHES "/${source}[.]cpp([ \"\r]|$)")
            math(EXPR count "${count} + 1")
            if(macro_required AND NOT line MATCHES "[-/]DRC_MUSIC_ENABLE_FIXTURE_SCENARIOS(=1)?( |$)")
                message(FATAL_ERROR "Scenario macro missing from compilation: ${source}")
            endif()
        endif()
    endforeach()
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one compilation of ${source}; found ${count}")
    endif()
endfunction()

cmake_path(CONVERT "${BUILD_DIRECTORY}" TO_CMAKE_PATH_LIST build_root NORMALIZE)
set(binding_targets
    rc_music_ui_shell_platform_binding_tests rc_music_ui_system_media_controls_binding_tests
    rc_music_ui_system_power_events_binding_tests rc_music_ui_diagnostic_binding_tests)
set(binding_sources
    ShellPlatformBindingTests SystemMediaControlsBindingTests
    SystemPowerEventsBindingTests ShellDiagnosticBindingTests)
foreach(target IN ITEMS m0_qt_shell rc_music_ui_quick_tests ${binding_targets})
    execute_process(COMMAND "${NINJA_COMMAND}" -C "${BUILD_DIRECTORY}" -t commands "${target}"
        RESULT_VARIABLE status OUTPUT_VARIABLE graph ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR graph STREQUAL "")
        message(FATAL_ERROR "Cannot inspect ${target} command closure: ${error}")
    endif()
    string(REPLACE "\\" "/" graph "${graph}")
    if(target STREQUAL "m0_qt_shell")
        if(graph MATCHES "RC_MUSIC_ENABLE_FIXTURE_SCENARIOS|tests/ui|fixture_data|FixtureRepository|DeterministicPlaybackBackend|rc_music_test_ui|rc_music_ui_scenario_support|/(fixture|queue)[.]v1[.]json")
            message(FATAL_ERROR "Product application reaches scenario/test inputs")
        endif()
        if(NOT graph MATCHES "m0_qt_shell_ui[.]lib" OR NOT graph MATCHES "m0_qt_shell_uiplugin[.]lib")
            message(FATAL_ERROR "Product application is missing its production UI/plugin")
        endif()
        # Commands prove resource-directory separation, not the contents of QRC
        # inputs. The reachable QRC files also receive an independent review.
        string(REPLACE "\n" ";" lines "${graph}")
        foreach(line IN LISTS lines)
            if(line MATCHES "rcc[.]exe")
                string(FIND "${line}" "${build_root}/src/.qt/rcc/" resource_directory)
                if(resource_directory LESS 0)
                    message(FATAL_ERROR "Product RCC command leaves its production resource directory")
                endif()
            endif()
        endforeach()
        set(ui m0_qt_shell_ui)
        set(scenarios OFF)
        require_compilation("${graph}" "ShellDiagnosticBinding" OFF)
    else()
        if(graph MATCHES "m0_qt_shell_ui[.]lib|m0_qt_shell_ui_qmltyperegistrations|m0_qt_shell_uiplugin|m0_qt_diagnostic_binding[.]lib")
            message(FATAL_ERROR "${target} also reaches the production QML module/plugin or diagnostic binding")
        endif()
        set(libraries rc_music_test_ui rc_music_ui_scenario_support)
        if(target STREQUAL "rc_music_ui_quick_tests")
            list(APPEND libraries rc_music_test_uiplugin)
            require_compilation("${graph}" "quick_main" ON)
        else()
            list(FIND binding_targets "${target}" binding_index)
            list(GET binding_sources ${binding_index} binding_source)
            require_compilation("${graph}" "${binding_source}" ON)
            if(target STREQUAL "rc_music_ui_diagnostic_binding_tests")
                require_compilation("${graph}" "ShellDiagnosticBinding" ON)
            endif()
        endif()
        foreach(library IN LISTS libraries)
            if(NOT graph MATCHES "${library}[.]lib")
                message(FATAL_ERROR "${target} is missing ${library}")
            endif()
        endforeach()
        set(ui rc_music_test_ui)
        set(scenarios ON)
    endif()
    require_compilation("${graph}" "PlayerPresenter" "${scenarios}")
    require_compilation("${graph}" "[^ /]+_qmltyperegistrations" "${scenarios}")
    require_compilation("${graph}" "${ui}_autogen/mocs_compilation" "${scenarios}")
endforeach()
message(STATUS "Product, Quick and binding-test UI command closures are isolated")
