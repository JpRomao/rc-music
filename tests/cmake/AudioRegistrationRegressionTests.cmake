cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED SCRATCH_DIRECTORY OR NOT DEFINED CTEST_COMMAND)
    message(FATAL_ERROR "Registration regression requires an owned scratch directory and CTest")
endif()
cmake_path(ABSOLUTE_PATH SCRATCH_DIRECTORY NORMALIZE OUTPUT_VARIABLE scratch_root)
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef run_id)
set(probe_root "${scratch_root}/audio-registration-${run_id}")
if(EXISTS "${probe_root}")
    message(FATAL_ERROR "Refusing to reuse a registration probe directory")
endif()

# CTest reads this real registration, including properties applied after an
# include. Any accidental test execution leaves a marker and fails this probe.
set(metadata_template [==[
add_test([=[rc_music.metadata.first]=] [=[@CMAKE_COMMAND@]=] -E touch [=[@case_root@/test-executed]=])
add_test([=[rc_music.metadata.second]=] [=[@CMAKE_COMMAND@]=] -E touch [=[@case_root@/test-executed]=])
set_tests_properties([=[rc_music.metadata.first]=] PROPERTIES LABELS audio)
set_tests_properties([=[rc_music.metadata.second]=] PROPERTIES LABELS unrelated)
]==])
set(registration_template [==[
include([=[@case_root@/MetadataCases.cmake]=])
set_tests_properties([=[rc_music.metadata.second]=] PROPERTIES LABELS [=[@second_label@]=])
add_test([=[rc_music.unrelated]=] [=[@CMAKE_COMMAND@]=] -E touch [=[@case_root@/test-executed]=])
]==])
foreach(case IN ITEMS valid missing-label near-label empty broken custom-cmake custom-ctest)
    set(case_root "${probe_root}/${case} espaços")
    file(MAKE_DIRECTORY "${case_root}/Testing/Temporary")
    set(second_label audio)
    if(case STREQUAL "missing-label")
        set(second_label unrelated)
    elseif(case STREQUAL "near-label")
        set(second_label audio-extra)
    endif()
    string(CONFIGURE "${metadata_template}" metadata @ONLY)
    string(CONFIGURE "${registration_template}" registration @ONLY)
    file(WRITE "${case_root}/MetadataCases.cmake" "${metadata}")
    if(case STREQUAL "empty")
        set(registration "# No metadata tests registered.\n")
    elseif(case STREQUAL "broken")
        set(registration "include(missing-registration.cmake)\n")
    endif()
    file(WRITE "${case_root}/CTestTestfile.cmake" "${registration}")
    if(case STREQUAL "custom-cmake")
        file(WRITE "${case_root}/CTestCustom.cmake" "# Must not be silently ignored.\n")
    elseif(case STREQUAL "custom-ctest")
        file(WRITE "${case_root}/CTestCustom.ctest" "# Must not be silently ignored.\n")
    endif()
    set(parent_log "${case_root}/Testing/Temporary/LastTest.log")
    file(WRITE "${parent_log}" "Parent suite evidence — must remain byte-identical.\n")
    file(SHA256 "${parent_log}" before_hash)

    execute_process(COMMAND "${CMAKE_COMMAND}" "-DBUILD_DIRECTORY=${case_root}"
        "-DCTEST_COMMAND=${CTEST_COMMAND}" -P "${CMAKE_CURRENT_LIST_DIR}/AudioRegistrationTests.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    file(SHA256 "${parent_log}" after_hash)
    if(NOT before_hash STREQUAL after_hash)
        message(FATAL_ERROR "Registration inspection changed the parent log (${case})")
    endif()
    if(EXISTS "${case_root}/test-executed")
        message(FATAL_ERROR "Registration inspection executed a test (${case})")
    endif()
    if(case STREQUAL "valid")
        if(NOT status STREQUAL "0" OR NOT output MATCHES "All 2 metadata tests")
            message(FATAL_ERROR "Valid registration rejected: ${status} ${output}${error}")
        endif()
    else()
        if(case STREQUAL "empty")
            set(expected "Metadata test registration is empty")
        elseif(case STREQUAL "broken")
            set(expected "Cannot read metadata test registration")
        elseif(case MATCHES "^custom-")
            set(expected "Registration inspection requires explicit support")
        else()
            set(expected "Metadata test must belong to the audio label")
        endif()
        if(status STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}")
            message(FATAL_ERROR "Wrong rejection (${case}): ${status} ${output}${error}")
        endif()
    endif()
endforeach()

# Only this invocation's newly created subtree may be removed.
cmake_path(IS_PREFIX scratch_root "${probe_root}" NORMALIZE owned)
if(NOT owned OR NOT probe_root MATCHES "/audio-registration-[0-9a-f]+$")
    message(FATAL_ERROR "Refusing cleanup outside the owned registration probe")
endif()
file(REMOVE_RECURSE "${probe_root}")
message(STATUS "Registration inspection: 7 cases preserve logs and never execute tests")
