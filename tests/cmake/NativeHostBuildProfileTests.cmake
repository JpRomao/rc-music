cmake_minimum_required(VERSION 3.31)
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(writer "${source_root}/cmake/WriteNativeHostBuildProfile.cmake")

if(DEFINED NATIVE_HOST_PROFILE_CASE)
    if(NOT DEFINED CASE_DIRECTORY OR NOT IS_ABSOLUTE "${CASE_DIRECTORY}")
        message(FATAL_ERROR "The fixture requires its own absolute directory")
    endif()
    file(MAKE_DIRECTORY "${CASE_DIRECTORY}/payload" "${CASE_DIRECTORY}/config")
    set(EXECUTABLE "${CASE_DIRECTORY}/payload/NativeHost.exe")
    set(CONFIGURATION "${CASE_DIRECTORY}/config/NativeHostBuildConfiguration.hpp")
    set(OUTPUT "${CASE_DIRECTORY}/profile.json")
    set(PROTOCOL "youtube.audio.v1")
    set(HOST_NAME "com.rcmusic.youtube")
    set(ORIGIN "chrome-extension://bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/")
    set(ENDPOINT "rc-music-profile-test")
    set(OWNER_IMAGES "RCMusic.exe;RCMusicTest.exe")
    set(HOST_IMAGES "NativeHost.exe")
    file(WRITE "${EXECUTABLE}" "synthetic host bytes\n")
    file(WRITE "${CONFIGURATION}" "// synthetic compiled configuration fixture\n")
    file(SHA256 "${CONFIGURATION}" EXPECTED_CONFIGURATION_SHA256)

    if(NATIVE_HOST_PROFILE_CASE STREQUAL "disabled-youtube")
        set(ORIGIN "")
        set(ENDPOINT "")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "disabled-direct")
        set(PROTOCOL "direct.media.v1")
        set(HOST_NAME "com.rcmusic.media")
        set(ORIGIN "")
        set(ENDPOINT "")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "enabled-youtube")
        # Exact synthetic identity only, never a production origin.
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "enabled-direct")
        set(PROTOCOL "direct.media.v1")
        set(HOST_NAME "com.rcmusic.media")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "endpoint96")
        string(REPEAT "x" 96 ENDPOINT)
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "normalized-paths")
        set(EXECUTABLE "${CASE_DIRECTORY}/payload/../payload/./NativeHost.exe")
        set(CONFIGURATION "${CASE_DIRECTORY}/config/./NativeHostBuildConfiguration.hpp")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "casefold-host-and-pin")
        set(HOST_IMAGES "nativehost.EXE")
        string(TOUPPER "${EXPECTED_CONFIGURATION_SHA256}" EXPECTED_CONFIGURATION_SHA256)
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "replace-own-receipt")
        file(WRITE "${OUTPUT}" "old mutable build receipt\n")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "origin-only")
        set(ENDPOINT "")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "endpoint-only")
        set(ORIGIN "")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "web-origin")
        set(ORIGIN "https://www.youtube.com/")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "uppercase-origin")
        set(ORIGIN "chrome-extension://BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB/")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "invalid-origin-alphabet")
        set(ORIGIN "chrome-extension://qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq/")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "endpoint-path")
        set(ENDPOINT "rc/music/test")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "endpoint97")
        string(REPEAT "x" 97 ENDPOINT)
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "unknown-protocol")
        set(PROTOCOL "youtube.audio.v2")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "cross-family-name")
        set(HOST_NAME "com.rcmusic.media")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "missing-executable")
        file(REMOVE "${EXECUTABLE}")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "empty-executable")
        file(WRITE "${EXECUTABLE}" "")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "directory-executable")
        set(EXECUTABLE "${CASE_DIRECTORY}/payload")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "relative-executable")
        set(EXECUTABLE "NativeHost.exe")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "missing-configuration")
        file(REMOVE "${CONFIGURATION}")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "directory-configuration")
        set(CONFIGURATION "${CASE_DIRECTORY}/config")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "relative-configuration")
        set(CONFIGURATION "NativeHostBuildConfiguration.hpp")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "configuration-drift")
        file(APPEND "${CONFIGURATION}" "// changed after configure\n")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "configuration-drift-preserves-receipt")
        file(APPEND "${CONFIGURATION}" "// changed after configure\n")
        file(WRITE "${OUTPUT}" "old mutable build receipt\n")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "invalid-configuration-pin")
        set(EXPECTED_CONFIGURATION_SHA256 "not-a-digest")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "empty-owner-images")
        set(OWNER_IMAGES "")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "owner-path")
        set(OWNER_IMAGES "../RCMusic.exe")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "owner-invalid-stem")
        set(OWNER_IMAGES "RC.Music.exe")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "owner-device")
        set(OWNER_IMAGES "CON.exe")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "too-many-owners")
        set(OWNER_IMAGES "One.exe;Two.exe;Three.exe;Four.exe;Five.exe")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "empty-host-images")
        set(HOST_IMAGES "")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "host-path")
        set(HOST_IMAGES "sub/NativeHost.exe")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "host-image-mismatch")
        set(HOST_IMAGES "AnotherHost.exe")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "relative-output")
        set(OUTPUT "profile.json")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "directory-output")
        set(OUTPUT "${CASE_DIRECTORY}/payload")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "output-overwrites-executable")
        set(OUTPUT "${EXECUTABLE}")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "output-overwrites-configuration")
        set(OUTPUT "${CONFIGURATION}")
    elseif(NATIVE_HOST_PROFILE_CASE STREQUAL "output-parent-is-file")
        file(WRITE "${CASE_DIRECTORY}/not-a-directory" "preserve me")
        set(OUTPUT "${CASE_DIRECTORY}/not-a-directory/profile.json")
    elseif(NATIVE_HOST_PROFILE_CASE MATCHES "^missing-(OUTPUT|EXECUTABLE|CONFIGURATION|EXPECTED_CONFIGURATION_SHA256|PROTOCOL|HOST_NAME|ORIGIN|ENDPOINT|OWNER_IMAGES|HOST_IMAGES)$")
        unset("${CMAKE_MATCH_1}")
    else()
        message(FATAL_ERROR "Unknown closed native host profile fixture")
    endif()
    include("${writer}")
    return()
endif()

set(valid_cases disabled-youtube disabled-direct enabled-youtube enabled-direct endpoint96 normalized-paths
    casefold-host-and-pin replace-own-receipt)
set(invalid_cases origin-only endpoint-only web-origin uppercase-origin invalid-origin-alphabet endpoint-path
    endpoint97 unknown-protocol cross-family-name missing-executable empty-executable directory-executable
    relative-executable missing-configuration directory-configuration relative-configuration configuration-drift
    configuration-drift-preserves-receipt
    invalid-configuration-pin empty-owner-images owner-path owner-invalid-stem owner-device too-many-owners empty-host-images
    host-path host-image-mismatch relative-output directory-output output-overwrites-executable
    output-overwrites-configuration output-parent-is-file)
foreach(required IN ITEMS OUTPUT EXECUTABLE CONFIGURATION EXPECTED_CONFIGURATION_SHA256 PROTOCOL HOST_NAME
        ORIGIN ENDPOINT OWNER_IMAGES HOST_IMAGES)
    list(APPEND invalid_cases "missing-${required}")
endforeach()

string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
if(DEFINED TEST_DIRECTORY)
    cmake_path(ABSOLUTE_PATH TEST_DIRECTORY NORMALIZE OUTPUT_VARIABLE test_parent)
elseif(DEFINED ENV{TEMP} AND NOT "$ENV{TEMP}" STREQUAL "")
    file(TO_CMAKE_PATH "$ENV{TEMP}" test_parent)
else()
    set(test_parent "${CMAKE_CURRENT_BINARY_DIR}")
endif()
if(NOT IS_ABSOLUTE "${test_parent}")
    message(FATAL_ERROR "The fixture parent must be absolute")
endif()
set(test_root "${test_parent}/RC Music native profile espaço-音-${nonce}")
file(MAKE_DIRECTORY "${test_root}")
file(WRITE "${test_root}/fixture-owner.txt" "${nonce}")
set(failures "")
set(passed 0)

function(assert_json json field expected_type expected_value)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${json}" ${field})
    if(NOT error STREQUAL "NOTFOUND" OR NOT actual_type STREQUAL expected_type)
        message(FATAL_ERROR "Wrong JSON type at ${field}: ${actual_type}, ${error}")
    endif()
    string(JSON actual GET "${json}" ${field})
    if(NOT actual STREQUAL expected_value)
        message(FATAL_ERROR "Wrong JSON value at ${field}: ${actual}")
    endif()
endfunction()

foreach(case IN LISTS valid_cases invalid_cases)
    set(case_root "${test_root}/${case}")
    file(MAKE_DIRECTORY "${case_root}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DNATIVE_HOST_PROFILE_CASE=${case}"
        "-DCASE_DIRECTORY=${case_root}" -P "${CMAKE_CURRENT_LIST_FILE}"
        WORKING_DIRECTORY "${case_root}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case IN_LIST invalid_cases)
        if(status STREQUAL "0")
            list(APPEND failures "invalid input admitted: ${case}")
        elseif(case STREQUAL "configuration-drift-preserves-receipt")
            file(READ "${case_root}/profile.json" preserved)
            if(NOT preserved STREQUAL "old mutable build receipt\n")
                list(APPEND failures "rejected drift replaced the previous receipt")
            else()
                math(EXPR passed "${passed} + 1")
            endif()
        elseif(EXISTS "${case_root}/profile.json")
            list(APPEND failures "rejected input left a receipt: ${case}")
        else()
            math(EXPR passed "${passed} + 1")
        endif()
        # Rejection cannot replace either input, including output path aliases.
        if(EXISTS "${case_root}/payload/NativeHost.exe" AND NOT case STREQUAL "empty-executable")
            file(READ "${case_root}/payload/NativeHost.exe" bytes)
            if(NOT bytes STREQUAL "synthetic host bytes\n")
                list(APPEND failures "executable source changed: ${case}")
            endif()
        endif()
        if(EXISTS "${case_root}/config/NativeHostBuildConfiguration.hpp")
            file(READ "${case_root}/config/NativeHostBuildConfiguration.hpp" bytes)
            set(expected "// synthetic compiled configuration fixture\n")
            if(case MATCHES "^configuration-drift")
                string(APPEND expected "// changed after configure\n")
            endif()
            if(NOT bytes STREQUAL expected)
                list(APPEND failures "configuration source changed: ${case}")
            endif()
        endif()
        continue()
    endif()
    if(NOT status STREQUAL "0")
        list(APPEND failures "valid input refused: ${case}: ${error}")
        continue()
    endif()
    if(NOT EXISTS "${case_root}/profile.json")
        list(APPEND failures "valid input produced no receipt: ${case}")
        continue()
    endif()
    file(READ "${case_root}/profile.json" receipt)
    file(READ "${case_root}/payload/NativeHost.exe" source_executable)
    file(READ "${case_root}/config/NativeHostBuildConfiguration.hpp" source_configuration)
    if(NOT source_executable STREQUAL "synthetic host bytes\n" OR
       NOT source_configuration STREQUAL "// synthetic compiled configuration fixture\n")
        list(APPEND failures "valid receipt generation changed a source: ${case}")
    endif()
    string(JSON root_length LENGTH "${receipt}")
    if(NOT root_length EQUAL 11)
        list(APPEND failures "receipt must have exactly eleven fields: ${case}")
        continue()
    endif()
    assert_json("${receipt}" schema_version NUMBER 1)
    assert_json("${receipt}" component STRING "rcmusic-native-host-build-profile")
    if(case MATCHES "direct$")
        assert_json("${receipt}" protocol STRING "direct.media.v1")
        assert_json("${receipt}" host_name STRING "com.rcmusic.media")
    else()
        assert_json("${receipt}" protocol STRING "youtube.audio.v1")
        assert_json("${receipt}" host_name STRING "com.rcmusic.youtube")
    endif()
    if(case MATCHES "^disabled-")
        assert_json("${receipt}" enabled BOOLEAN OFF)
        assert_json("${receipt}" origin STRING "")
        assert_json("${receipt}" endpoint STRING "")
    else()
        assert_json("${receipt}" enabled BOOLEAN ON)
        assert_json("${receipt}" origin STRING "chrome-extension://bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/")
        if(case STREQUAL "endpoint96")
            string(REPEAT "x" 96 endpoint)
        else()
            set(endpoint "rc-music-profile-test")
        endif()
        assert_json("${receipt}" endpoint STRING "${endpoint}")
    endif()
    foreach(field IN ITEMS owner_images host_images)
        string(JSON type TYPE "${receipt}" ${field})
        string(JSON length LENGTH "${receipt}" ${field})
        if(NOT type STREQUAL "ARRAY" OR (field STREQUAL "owner_images" AND NOT length EQUAL 2) OR
            (field STREQUAL "host_images" AND NOT length EQUAL 1))
            list(APPEND failures "wrong basename array: ${case}/${field}")
        endif()
    endforeach()
    assert_json("${receipt}" "owner_images;0" STRING "RCMusic.exe")
    assert_json("${receipt}" "owner_images;1" STRING "RCMusicTest.exe")
    if(case STREQUAL "casefold-host-and-pin")
        assert_json("${receipt}" "host_images;0" STRING "nativehost.EXE")
    else()
        assert_json("${receipt}" "host_images;0" STRING "NativeHost.exe")
    endif()
    string(JSON executable_length LENGTH "${receipt}" executable)
    string(JSON configuration_length LENGTH "${receipt}" configuration)
    if(NOT executable_length EQUAL 3 OR NOT configuration_length EQUAL 2)
        list(APPEND failures "unexpected nested receipt fields: ${case}")
    endif()
    file(SHA256 "${case_root}/payload/NativeHost.exe" exe_hash)
    file(SIZE "${case_root}/payload/NativeHost.exe" exe_size)
    file(SHA256 "${case_root}/config/NativeHostBuildConfiguration.hpp" configuration_hash)
    assert_json("${receipt}" "executable;path" STRING "${case_root}/payload/NativeHost.exe")
    assert_json("${receipt}" "executable;sha256" STRING "${exe_hash}")
    assert_json("${receipt}" "executable;size_bytes" NUMBER "${exe_size}")
    assert_json("${receipt}" "configuration;path" STRING "${case_root}/config/NativeHostBuildConfiguration.hpp")
    assert_json("${receipt}" "configuration;sha256" STRING "${configuration_hash}")
    math(EXPR passed "${passed} + 1")
endforeach()

# This exact nonce-marked test tree was created above; no outside paths are
# enumerated or removed. All synchronous fixture children have already exited.
file(READ "${test_root}/fixture-owner.txt" owner)
if(NOT owner STREQUAL nonce OR test_root STREQUAL test_parent)
    message(FATAL_ERROR "Refusing cleanup of an unowned test tree")
endif()
file(REMOVE_RECURSE "${test_root}")
list(LENGTH valid_cases valid_count)
list(LENGTH invalid_cases invalid_count)
math(EXPR total "${valid_count} + ${invalid_count}")
message(STATUS "Native host build profile: ${passed}/${total} cases passed")
if(failures)
    list(JOIN failures "\n" failure_text)
    message(FATAL_ERROR "${failure_text}")
endif()
