cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED BUILD_DIRECTORY OR NOT DEFINED NINJA_COMMAND)
    message(FATAL_ERROR "Native boundary requires BUILD_DIRECTORY and NINJA_COMMAND")
endif()
cmake_path(ABSOLUTE_PATH BUILD_DIRECTORY NORMALIZE OUTPUT_VARIABLE build_root)
foreach(target IN ITEMS rc_music_browser_integration rc_music_native_host)
    execute_process(COMMAND "${NINJA_COMMAND}" -C "${build_root}" -t commands "${target}"
        RESULT_VARIABLE status OUTPUT_VARIABLE graph ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR graph STREQUAL "")
        message(FATAL_ERROR "Cannot inspect ${target} dependency closure: ${error}")
    endif()
    string(REPLACE "\\" "/" graph "${graph}")
    string(REPLACE "${build_root}" "<build>" graph "${graph}")
    if(graph MATCHES "test-native-host|M0_QT_SHELL_TEST_HOOKS|RC_MUSIC_NATIVE_DOWNLOAD_SMOKE_AVAILABLE|/tests/|Qt6Test|Catch2|watchdog_helper|native_host_test|native_host_disabled_test|native_owner_helper|NativeDownloadOwnerProcess_tests|Qt6WebEngine|Qt6Multimedia")
        message(FATAL_ERROR "${target} reaches a test hook, helper, browser engine or audio dependency")
    endif()
    if(target STREQUAL "rc_music_browser_integration")
        if(graph MATCHES "Qt6Network|QT_NETWORK_LIB|QtNativeDownload|NativeDownloadPeer|WindowsNativeMessagingIo|WindowsNativeDownload(Lease|PipeReservation)|NativeHostLaunch")
            message(FATAL_ERROR "The parser/session library acquired the optional transport")
        endif()
    elseif(NOT graph MATCHES "native_host_main[.]cpp" OR NOT graph MATCHES "<build>/native-host")
        message(FATAL_ERROR "Native host must compile real main with its private production configuration")
    endif()
endforeach()
file(READ "${build_root}/native-host/NativeHostBuildConfiguration.hpp" trusted_configuration)
if(trusted_configuration MATCHES "rc_music_native_host_test|rc_music_NativeHostProcess_tests|rc_music_test_shell")
    message(FATAL_ERROR "Production peer image profile contains a synthetic test identity")
endif()
foreach(image IN ITEMS RCMusic.exe rc_music_native_host.exe)
    string(FIND "${trusted_configuration}" "QStringLiteral(\"${image}\")" image_position)
    if(image_position EQUAL -1)
        message(FATAL_ERROR "Production native peer profile lost its fixed payload role: ${image}")
    endif()
endforeach()
foreach(field IN ITEMS RC_MUSIC_NATIVE_MAIN_ORIGIN RC_MUSIC_NATIVE_ENDPOINT)
    file(STRINGS "${build_root}/CMakeCache.txt" configured REGEX "^${field}:STRING=")
    string(REGEX REPLACE "^[^=]+=" "" configured "${configured}")
    string(FIND "${trusted_configuration}" "QStringLiteral(\"${configured}\")" field_position)
    if(field_position EQUAL -1)
        message(FATAL_ERROR "Production host identity differs from its trusted ${field} configuration")
    endif()
endforeach()
message(STATUS "Native product/test identities are isolated; browser boundary remains Qt Core-only")
