# Run only after the exact fixture targets have built. Never hash stale outputs
# during configure, and never perform artifact discovery/hashing on the UI.
foreach(name IN ITEMS OUTPUT TEMPLATE PAYLOAD_ROOT PROFILE_PYTHON PROFILE_RECIPE BOOTSTRAP PAYLOAD CORE NETWORK
        CRT_DIR PLUGIN MEDIA)
    if(NOT DEFINED ${name} OR "${${name}}" STREQUAL "")
        message(FATAL_ERROR "Missing fixture build input ${name}")
    endif()
endforeach()
set(inputs "${BOOTSTRAP}" "${PAYLOAD}" "${CORE}" "${NETWORK}"
    "${CRT_DIR}/msvcp140.dll" "${CRT_DIR}/msvcp140_1.dll"
    "${CRT_DIR}/vcruntime140.dll" "${CRT_DIR}/vcruntime140_1.dll" "${PLUGIN}")
function(fixture_json_string output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(config "{}")
string(JSON config SET "${config}" schemaVersion 1)
# The recipe confines candidates to its repository even in plan-only mode.
# Keep this unused, fresh path independent of the caller's CMake build location.
get_filename_component(recipe_directory "${PROFILE_RECIPE}" DIRECTORY)
get_filename_component(recipe_repository "${recipe_directory}/../.." ABSOLUTE)
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef plan_nonce)
fixture_json_string(value "${recipe_repository}/out/product/test-runs/package-profile-plan-only-${plan_nonce}")
string(JSON config SET "${config}" output_directory "${value}")
string(JSON config SET "${config}" youtube null)
set(network "[]")
set(network_roles Bootstrap Payload Core Network Msvcp140 Msvcp140_1 Vcruntime140 Vcruntime140_1 Plugin)
set(network_leaves RCMusicDownloadWorker.exe rcmusic-download-network.dll Qt6Core.dll Qt6Network.dll
    msvcp140.dll msvcp140_1.dll vcruntime140.dll vcruntime140_1.dll qrcmusicschanneloffline.dll)
set(index 0)
foreach(input IN LISTS inputs)
    file(SHA256 "${input}" hash)
    file(SIZE "${input}" bytes)
    list(GET network_roles ${index} role)
    set(record "{}")
    fixture_json_string(value "${role}")
    string(JSON record SET "${record}" role "${value}")
    fixture_json_string(value "${hash}")
    string(JSON record SET "${record}" sha256 "${value}")
    string(JSON record SET "${record}" bytes "${bytes}")
    list(GET network_leaves ${index} leaf)
    set(path "download-tools/network/${leaf}")
    file(MAKE_DIRECTORY "${PAYLOAD_ROOT}/download-tools/network")
    file(COPY_FILE "${input}" "${PAYLOAD_ROOT}/${path}" ONLY_IF_DIFFERENT)
    file(SHA256 "${PAYLOAD_ROOT}/${path}" copied_hash)
    if(NOT copied_hash STREQUAL hash)
        message(FATAL_ERROR "Fixture network copy differs from its pinned source")
    endif()
    # The offline transport helper is renamed to the production role basename.
    # Plan the already authenticated fixture copy through the real recipe.
    fixture_json_string(value "${PAYLOAD_ROOT}/${path}")
    string(JSON record SET "${record}" path "${value}")
    string(JSON network SET "${network}" ${index} "${record}")
    math(EXPR index "${index} + 1")
endforeach()
file(SHA256 "${MEDIA}" fixture_media_hash)
file(SIZE "${MEDIA}" media_bytes)
set(media "{}")
fixture_json_string(value "${fixture_media_hash}")
string(JSON media SET "${media}" sha256 "${value}")
string(JSON media SET "${media}" bytes "${media_bytes}")
string(JSON config SET "${config}" network "${network}")
set(fixture_media "download-tools/media/RCMusicMediaWorker.exe")
file(MAKE_DIRECTORY "${PAYLOAD_ROOT}/download-tools/media")
file(COPY_FILE "${MEDIA}" "${PAYLOAD_ROOT}/${fixture_media}" ONLY_IF_DIFFERENT)
file(SHA256 "${PAYLOAD_ROOT}/${fixture_media}" copied_media_hash)
if(NOT copied_media_hash STREQUAL fixture_media_hash)
    message(FATAL_ERROR "Fixture media copy differs from its pinned source")
endif()
fixture_json_string(value "${PAYLOAD_ROOT}/${fixture_media}")
string(JSON media SET "${media}" path "${value}")
string(JSON config SET "${config}" media "${media}")
get_filename_component(profile_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${profile_directory}")
set(config_path "${profile_directory}/package-profile-config.json")
file(WRITE "${config_path}" "${config}\n")
execute_process(COMMAND "${PROFILE_PYTHON}" -B -I "${PROFILE_RECIPE}" --config "${config_path}" --plan-only
    RESULT_VARIABLE status OUTPUT_VARIABLE planned ERROR_VARIABLE diagnostic)
if(NOT status STREQUAL "0" OR NOT diagnostic STREQUAL "")
    message(FATAL_ERROR "Package fixture plan failed: ${status}: ${diagnostic}")
endif()
string(JSON header_text ERROR_VARIABLE header_error GET "${planned}" header_text)
if(NOT header_error STREQUAL "NOTFOUND" OR header_text STREQUAL "")
    message(FATAL_ERROR "Package fixture plan did not contain its generated header")
endif()
set(fixture_packaged_header "${profile_directory}/PackagedDownloadsFixtureProfile.hpp")
file(WRITE "${fixture_packaged_header}" "${header_text}")
configure_file("${TEMPLATE}" "${OUTPUT}" @ONLY)
