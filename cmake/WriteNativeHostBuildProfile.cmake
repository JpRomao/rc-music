cmake_minimum_required(VERSION 3.31)

# Build-time consistency receipt only. This must never install a host, attest a
# browser/publisher or supply runtime configuration to the player.
foreach(required IN ITEMS OUTPUT EXECUTABLE CONFIGURATION EXPECTED_CONFIGURATION_SHA256 PROTOCOL HOST_NAME
        ORIGIN ENDPOINT OWNER_IMAGES HOST_IMAGES)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing native host profile input: ${required}")
    endif()
endforeach()

if(PROTOCOL STREQUAL "youtube.audio.v1")
    set(expected_host "com.rcmusic.youtube")
elseif(PROTOCOL STREQUAL "direct.media.v1")
    set(expected_host "com.rcmusic.media")
else()
    message(FATAL_ERROR "Unknown native host profile protocol")
endif()
if(NOT HOST_NAME STREQUAL expected_host)
    message(FATAL_ERROR "Native host name does not match its protocol")
endif()

# Reuse the actual compiled profile grammar without loading Qt or targets.
include("${CMAKE_CURRENT_LIST_DIR}/RcMusicNativeMessaging.cmake")
rc_music_validate_native_messaging_identities("${ORIGIN}" "${ENDPOINT}" "" "")

foreach(field IN ITEMS OWNER_IMAGES HOST_IMAGES)
    list(LENGTH ${field} count)
    if(count LESS 1 OR count GREATER 4)
        message(FATAL_ERROR "Native image roles require one to four basenames")
    endif()
    foreach(image IN LISTS ${field})
        string(LENGTH "${image}" image_length)
        if(image_length GREATER 32767 OR NOT image MATCHES "^[A-Za-z0-9_-]+[.][eE][xX][eE]$")
            message(FATAL_ERROR "Invalid native image basename")
        endif()
        string(REGEX REPLACE "[.][eE][xX][eE]$" "" stem "${image}")
        string(TOUPPER "${stem}" stem)
        if(stem MATCHES "^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])$")
            message(FATAL_ERROR "Native image basename is a reserved device")
        endif()
    endforeach()
endforeach()

function(native_profile_path output value)
    if(NOT IS_ABSOLUTE "${value}")
        message(FATAL_ERROR "Native profile paths must be absolute")
    endif()
    file(TO_CMAKE_PATH "${value}" normalized)
    cmake_path(NORMAL_PATH normalized)
    if(NOT normalized MATCHES "^[A-Za-z]:/")
        message(FATAL_ERROR "Native profile paths must use a local drive")
    endif()
    set(${output} "${normalized}" PARENT_SCOPE)
endfunction()

foreach(field IN ITEMS OUTPUT EXECUTABLE CONFIGURATION)
    native_profile_path(normalized_${field} "${${field}}")
endforeach()
foreach(field IN ITEMS EXECUTABLE CONFIGURATION)
    if(NOT EXISTS "${normalized_${field}}" OR IS_DIRECTORY "${normalized_${field}}")
        message(FATAL_ERROR "Native profile source is not a regular file")
    endif()
endforeach()
if(IS_DIRECTORY "${normalized_OUTPUT}")
    message(FATAL_ERROR "Native profile output is a directory")
endif()
get_filename_component(output_parent "${normalized_OUTPUT}" DIRECTORY)
if(NOT IS_DIRECTORY "${output_parent}")
    message(FATAL_ERROR "Native profile output parent must already exist")
endif()
string(TOLOWER "${normalized_OUTPUT}" output_folded)
foreach(field IN ITEMS EXECUTABLE CONFIGURATION)
    string(TOLOWER "${normalized_${field}}" source_folded)
    if(output_folded STREQUAL source_folded)
        message(FATAL_ERROR "Native profile output cannot replace an input")
    endif()
endforeach()
get_filename_component(executable_leaf "${normalized_EXECUTABLE}" NAME)
string(TOLOWER "${executable_leaf}" executable_leaf)
set(matched_host FALSE)
foreach(image IN LISTS HOST_IMAGES)
    string(TOLOWER "${image}" image_folded)
    if(image_folded STREQUAL executable_leaf)
        set(matched_host TRUE)
    endif()
endforeach()
if(NOT matched_host)
    message(FATAL_ERROR "Native executable does not match its host image role")
endif()

string(LENGTH "${EXPECTED_CONFIGURATION_SHA256}" digest_length)
if(NOT digest_length EQUAL 64 OR NOT EXPECTED_CONFIGURATION_SHA256 MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "Invalid configured native header digest")
endif()
string(TOLOWER "${EXPECTED_CONFIGURATION_SHA256}" expected_configuration_sha256)
file(SHA256 "${normalized_CONFIGURATION}" configuration_sha256)
if(NOT configuration_sha256 STREQUAL expected_configuration_sha256)
    message(FATAL_ERROR "Native configuration changed after configure")
endif()
file(SIZE "${normalized_EXECUTABLE}" executable_size)
if(executable_size LESS 1)
    message(FATAL_ERROR "Native executable must not be empty")
endif()
file(SHA256 "${normalized_EXECUTABLE}" executable_sha256)

function(native_json_string output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

set(receipt "{}")
string(JSON receipt SET "${receipt}" schema_version 1)
native_json_string(value "rcmusic-native-host-build-profile")
string(JSON receipt SET "${receipt}" component "${value}")
foreach(field IN ITEMS PROTOCOL HOST_NAME ORIGIN ENDPOINT)
    string(TOLOWER "${field}" key)
    native_json_string(value "${${field}}")
    string(JSON receipt SET "${receipt}" "${key}" "${value}")
endforeach()
if(ORIGIN STREQUAL "")
    string(JSON receipt SET "${receipt}" enabled false)
else()
    string(JSON receipt SET "${receipt}" enabled true)
endif()
foreach(field IN ITEMS OWNER_IMAGES HOST_IMAGES)
    set(images "[]")
    set(index 0)
    foreach(image IN LISTS ${field})
        native_json_string(value "${image}")
        string(JSON images SET "${images}" ${index} "${value}")
        math(EXPR index "${index} + 1")
    endforeach()
    string(TOLOWER "${field}" key)
    string(JSON receipt SET "${receipt}" "${key}" "${images}")
endforeach()
set(executable "{}")
native_json_string(value "${normalized_EXECUTABLE}")
string(JSON executable SET "${executable}" path "${value}")
native_json_string(value "${executable_sha256}")
string(JSON executable SET "${executable}" sha256 "${value}")
string(JSON executable SET "${executable}" size_bytes "${executable_size}")
string(JSON receipt SET "${receipt}" executable "${executable}")
set(configuration "{}")
native_json_string(value "${normalized_CONFIGURATION}")
string(JSON configuration SET "${configuration}" path "${value}")
native_json_string(value "${configuration_sha256}")
string(JSON configuration SET "${configuration}" sha256 "${value}")
string(JSON receipt SET "${receipt}" configuration "${configuration}")

# Check the configure pin again before touching the output. A failed build
# leaves the previous mutable receipt intact; consumers must still verify pins.
file(SHA256 "${normalized_CONFIGURATION}" final_configuration_sha256)
if(NOT final_configuration_sha256 STREQUAL expected_configuration_sha256)
    message(FATAL_ERROR "Native configuration changed before receipt publication")
endif()
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(temporary "${normalized_OUTPUT}.tmp-${nonce}")
file(WRITE "${temporary}" "${receipt}\n")
file(RENAME "${temporary}" "${normalized_OUTPUT}" RESULT rename_error)
if(NOT rename_error STREQUAL "0")
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Unable to publish native host build profile")
endif()
message(STATUS "Recorded the compiled native host build profile without installation")
