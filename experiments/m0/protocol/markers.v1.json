    "window_duration_ns": 5000000000,
    "minimum_input_interval_ns": 50000000,
    "minimum_complete_pairs": 1,
    "maximum_complete_pairs": 100,
    "first_probe_at_window_start": true,
    "next_input_requires_previous_ack": true,
    "unique_occurrence_id": true,
    "ack_after_window_closes_pair": true,
    "input_at_or_after_window_end_forbidden": true,
    "qpc_value_ns_formula": "floor((end_ticks-start_ticks)*1000000000/qpc_frequency)"
  },
  "visual_diagnostic_policy": {
    "decision_role": "diagnostic_only",
    "minimum_stable_baseline_ns": 500000000,
    "baseline_frames": 3,
    "uia_confirmation_timeout_ns": 2000000000,
    "budget_exceeded_forbidden": true
  },
