{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M0 environment descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "environment_id",
    "component_id",
    "recorded_on",
    "contract_sha256",
    "acceptance_ready",
    "benchmark_host",
    "platform_matrix",
    "toolchains",
    "provisioning_missing"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "environment_id": { "type": "string", "pattern": "^M0-E[1-9][0-9]*$" },
    "component_id": { "enum": ["M0-E1-WIN", "M0-E1-LINUX"] },
    "recorded_on": { "type": "string", "format": "date" },
    "contract_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "acceptance_ready": { "type": "boolean" },
    "benchmark_host": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["public_id", "os", "cpu", "logical_processors", "ram_bytes", "gpu", "storage", "display", "power_plan", "locale", "timezone", "webview2"],
          "properties": {
            "public_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "os": { "type": "string", "minLength": 1 },
            "cpu": { "type": "string", "minLength": 1 },
            "logical_processors": { "type": "integer", "minimum": 1 },
            "ram_bytes": { "type": "integer", "minimum": 1073741824 },
            "gpu": { "type": "string", "minLength": 1 },
            "storage": { "type": "string", "minLength": 1 },
            "display": { "type": "string", "minLength": 1 },
            "power_plan": { "type": "string", "minLength": 1 },
            "locale": { "type": "string", "minLength": 2 },
            "timezone": { "type": "string", "minLength": 1 },
            "webview2": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "platform_matrix": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tier", "required", "sessions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["tier-1", "tier-2", "compatibility-smoke", "legacy", "out-of-scope"] },
          "required": { "type": "boolean" },
          "sessions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "toolchains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target_version", "installed_version", "ready"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "target_version": { "type": "string", "minLength": 1 },
          "installed_version": { "type": ["string", "null"] },
          "ready": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "ready": { "const": true } } },
            "then": { "properties": { "installed_version": { "type": "string", "minLength": 1 } } }
          },
          {
            "if": { "properties": { "installed_version": { "type": "null" } } },
            "then": { "properties": { "ready": { "const": false } } }
          }
        ]
      }
    },
    "provisioning_missing": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
