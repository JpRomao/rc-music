{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M0 synthetic visual detector golden vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_id", "schema_version", "golden_id", "visual_id",
    "roi_vectors", "detection_vectors", "uia_vectors"
  ],
  "properties": {
    "$schema": { "const": "../schemas/visual-golden.schema.json" },
    "schema_id": { "const": "m0.visual-golden.v1" },
    "schema_version": { "const": 1 },
    "golden_id": { "const": "M0-VISUAL-GOLDEN-1" },
    "visual_id": { "const": "M0-VISUAL-1" },
    "roi_vectors": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/definitions/roi_vector" } },
    "detection_vectors": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/definitions/detection_vector" } },
    "uia_vectors": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/definitions/uia_vector" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "unsigned_decimal": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
    "signed_decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]{0,30})$" },
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "$ref": "#/definitions/signed_decimal" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" }
      }
    },
    "rational_rect": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "$ref": "#/definitions/rational" }, "top": { "$ref": "#/definitions/rational" },
        "right": { "$ref": "#/definitions/rational" }, "bottom": { "$ref": "#/definitions/rational" }
      }
    },
    "integer_rect": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer" }, "top": { "type": "integer" },
        "right": { "type": "integer" }, "bottom": { "type": "integer" }
      }
    },
    "roi_vector": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "control_rect", "client_rect", "expected"],
      "properties": {
        "case_id": { "$ref": "#/definitions/id" }, "control_rect": { "$ref": "#/definitions/rational_rect" },
        "client_rect": { "$ref": "#/definitions/integer_rect" }, "expected": { "$ref": "#/definitions/integer_rect" }
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_ordinal", "qpc_ticks", "qpc_frequency", "accumulated_frames", "bgra8_hex"],
      "properties": {
        "frame_ordinal": { "type": "integer", "minimum": -16, "maximum": 1024 },
        "qpc_ticks": { "$ref": "#/definitions/unsigned_decimal" },
        "qpc_frequency": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "accumulated_frames": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "bgra8_hex": { "type": "string", "pattern": "^(?:[a-f0-9]{2})+$" }
      }
    },
    "detection_expected": {
      "type": "object", "additionalProperties": false,
      "required": ["detected", "t1_frame_ordinal", "t1_qpc_ticks", "value_ns", "changed_pixel_count"],
      "properties": {
        "detected": { "type": "boolean" }, "t1_frame_ordinal": { "type": ["integer", "null"] },
        "t1_qpc_ticks": { "type": ["string", "null"], "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
        "value_ns": { "type": ["string", "null"], "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
        "changed_pixel_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "detection_vector": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "width", "height", "stride_bytes", "input_qpc_ticks", "qpc_frequency", "baseline", "observed", "expected"],
      "properties": {
        "case_id": { "$ref": "#/definitions/id" }, "width": { "type": "integer", "minimum": 1, "maximum": 128 },
        "height": { "type": "integer", "minimum": 1, "maximum": 128 },
        "stride_bytes": { "type": "integer", "minimum": 4, "maximum": 65536 },
        "input_qpc_ticks": { "$ref": "#/definitions/unsigned_decimal" },
        "qpc_frequency": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "baseline": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/definitions/frame" } },
        "observed": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/definitions/frame" } },
        "expected": { "$ref": "#/definitions/detection_expected" }
      }
    },
    "uia_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["automation_id", "role", "name", "has_keyboard_focus", "toggle_pattern_queried", "toggle_pattern_used", "qpc_ticks", "qpc_frequency"],
      "properties": {
        "automation_id": { "type": "string" }, "role": { "type": "string" },
        "name": { "type": "string" }, "has_keyboard_focus": { "type": "boolean" },
        "toggle_pattern_queried": { "type": "boolean" }, "toggle_pattern_used": { "type": "boolean" },
        "qpc_ticks": { "$ref": "#/definitions/unsigned_decimal" },
        "qpc_frequency": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      }
    },
    "uia_vector": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "initial_state_id", "input_qpc_ticks", "qpc_frequency", "before", "after", "expected_confirmation_qpc_ticks"],
      "properties": {
        "case_id": { "$ref": "#/definitions/id" }, "initial_state_id": { "const": "playing" },
        "input_qpc_ticks": { "$ref": "#/definitions/unsigned_decimal" },
        "qpc_frequency": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "before": { "$ref": "#/definitions/uia_observation" },
        "after": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/uia_observation" } },
        "expected_confirmation_qpc_ticks": { "$ref": "#/definitions/unsigned_decimal" }
      }
    }
  }
}
