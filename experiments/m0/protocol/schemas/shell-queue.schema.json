{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M0 deterministic 1000-item shell queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "queue_id", "generation_recipe_id", "item_count", "items"],
  "properties": {
    "schema_id": { "const": "m0.shell-queue.v1" },
    "schema_version": { "const": 1 },
    "queue_id": { "const": "M0-SHELL-Q1000" },
    "generation_recipe_id": { "const": "M0-Q1" },
    "item_count": { "const": 1000 },
    "items": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_index", "occurrence_id", "source", "metadata", "duration_ms", "availability", "error_code"],
      "properties": {
        "order_index": { "type": "integer", "minimum": 0, "maximum": 999 },
        "occurrence_id": { "type": "string", "pattern": "^queue-[0-9]{4}$" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_key", "presentation_form", "synthetic_path_segments", "file_name"],
          "properties": {
            "semantic_key": { "type": "string", "pattern": "^semantic-source-[a-z0-9-]+$" },
            "presentation_form": { "enum": ["nfc", "nfd"] },
            "synthetic_path_segments": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            },
            "file_name": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "artist", "album"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "artist": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "album": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "duration_ms": { "type": ["integer", "null"], "minimum": 1 },
        "availability": { "enum": ["available", "unavailable"] },
        "error_code": { "type": ["string", "null"] }
      }
    }
  }
}
