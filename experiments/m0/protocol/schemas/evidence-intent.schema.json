{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M0 recoverable evidence writer intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "transaction_id", "run_id", "paths",
    "raw_precondition", "expected"
  ],
  "properties": {
    "schema_id": { "const": "m0.evidence-intent.v1" },
    "schema_version": { "const": 1 },
    "transaction_id": { "$ref": "#/definitions/sha256" },
    "run_id": { "$ref": "#/definitions/id" },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_relative_path", "run_relative_path", "intent_relative_path",
        "snapshot_relative_path", "run_temp_relative_path", "snapshot_temp_relative_path"
      ],
      "properties": {
        "raw_relative_path": { "$ref": "#/definitions/leaf" },
        "run_relative_path": { "$ref": "#/definitions/leaf" },
        "intent_relative_path": { "$ref": "#/definitions/leaf" },
        "snapshot_relative_path": { "$ref": "#/definitions/leaf" },
        "run_temp_relative_path": { "$ref": "#/definitions/leaf" },
        "snapshot_temp_relative_path": { "$ref": "#/definitions/leaf" }
      }
    },
    "raw_precondition": { "$ref": "#/definitions/raw_state" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sealed_raw", "seal", "run", "snapshot"],
      "properties": {
        "sealed_raw": { "$ref": "#/definitions/raw_state" },
        "seal": { "$ref": "#/definitions/blob" },
        "run": { "$ref": "#/definitions/blob" },
        "snapshot": { "$ref": "#/definitions/blob" }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "leaf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\.)(?!.*\\.\\.)(?!.*[:/\\\\])[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "raw_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_bytes", "sha256", "event_count", "final_line_sha256"],
      "properties": {
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "event_count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "final_line_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_bytes", "sha256", "bytes_hex"],
      "properties": {
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes_hex": {
          "type": "string",
          "minLength": 2,
          "maxLength": 67108864,
          "pattern": "^(?:[a-f0-9]{2})+$"
        }
      }
    }
  }
}
