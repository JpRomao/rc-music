{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M0 common summary deterministic input",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "schema_version", "protocol_id", "experiment_id", "scenario_id", "source", "candidates", "raws", "traces"],
  "properties": {
    "$schema": { "const": "schemas/summary-input.schema.json" },
    "schema_id": { "const": "m0.summary-input.v1" },
    "schema_version": { "const": 1 },
    "protocol_id": { "const": "M0-P1" },
    "experiment_id": { "$ref": "#/definitions/id" },
    "scenario_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "source": { "$ref": "#/definitions/sourceReceipt" },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/definitions/candidate" }
    },
    "raws": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": { "$ref": "#/definitions/evidenceHash" }
    },
    "traces": {
      "type": "array",
      "items": { "$ref": "#/definitions/traceHash" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "commonInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_sha256", "environment_sha256", "fixture_sha256", "harness_sha256", "scenario_sha256"],
      "properties": {
        "protocol_sha256": { "$ref": "#/definitions/sha256" },
        "environment_sha256": { "$ref": "#/definitions/sha256" },
        "fixture_sha256": { "$ref": "#/definitions/sha256" },
        "harness_sha256": { "$ref": "#/definitions/sha256" },
        "scenario_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "sourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_set_contract_id", "snapshot_set_id", "snapshot_set_sha256", "batch_contract_id", "batch_id", "batch_sha256", "schedule_sha256"],
      "properties": {
        "snapshot_set_contract_id": { "const": "m0.evidence-snapshot-set.v1" },
        "snapshot_set_id": { "$ref": "#/definitions/id" },
        "snapshot_set_sha256": { "$ref": "#/definitions/sha256" },
        "batch_contract_id": { "const": "m0.batch.v1" },
        "batch_id": { "$ref": "#/definitions/id" },
        "batch_sha256": { "$ref": "#/definitions/sha256" },
        "schedule_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "metric_family", "unit", "values", "budget"],
      "properties": {
        "metric_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "metric_family": { "enum": ["latency_ms", "visual_response_ms", "memory_bytes", "cpu_percentage_points"] },
        "unit": { "enum": ["nanoseconds", "bytes", "basis_points"] },
        "values": { "type": "array", "maxItems": 22, "items": { "$ref": "#/definitions/attemptValue" } },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "threshold_integer"],
          "properties": {
            "operator": { "enum": ["less-than", "less-than-or-equal"] },
            "threshold_integer": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "metric_family": { "const": "cpu_percentage_points" } }, "required": ["metric_family"] },
          "then": {
            "properties": {
              "unit": { "const": "basis_points" },
              "values": { "items": { "$ref": "#/definitions/cpuAttemptValue" } },
              "budget": { "$ref": "#/definitions/cpuBudget" }
            }
          }
        }
      ]
    },
    "attemptValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "value_integer"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 22 },
        "value_integer": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      }
    },
    "cpuAttemptValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "value_integer"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 22 },
        "value_integer": { "type": "integer", "minimum": 0, "maximum": 100000000 }
      }
    },
    "cpuBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "threshold_integer"],
      "properties": {
        "operator": { "enum": ["less-than", "less-than-or-equal"] },
        "threshold_integer": { "type": "integer", "minimum": 0, "maximum": 100000000 }
      }
    },
    "soak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "result", "duration_seconds", "error_code"],
      "properties": {
        "applicable": { "type": "boolean" },
        "result": { "enum": ["pass", "fail", "inconclusive", "not_applicable"] },
        "duration_seconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 2147483647 },
        "error_code": { "type": ["string", "null"], "enum": [null, "soak_failed", "soak_incomplete"] }
      },
      "allOf": [
        {
          "if": { "properties": { "applicable": { "const": false } }, "required": ["applicable"] },
          "then": {
            "properties": {
              "result": { "const": "not_applicable" },
              "duration_seconds": { "const": null },
              "error_code": { "const": null }
            }
          },
          "else": {
            "properties": {
              "result": { "enum": ["pass", "fail", "inconclusive"] },
              "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
            }
          }
        },
        {
          "if": { "properties": { "result": { "const": "pass" } }, "required": ["result"] },
          "then": { "properties": { "error_code": { "const": null } } },
          "else": {
            "if": { "properties": { "result": { "const": "fail" } }, "required": ["result"] },
            "then": { "properties": { "error_code": { "const": "soak_failed" } } },
            "else": {
              "if": { "properties": { "result": { "const": "inconclusive" } }, "required": ["result"] },
              "then": { "properties": { "error_code": { "const": "soak_incomplete" } } }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_code", "common_inputs", "attempt_statuses", "metrics", "soak", "artifact_sha256", "toolchain_bundle_sha256", "lockfile_bundle_sha256", "runs_manifest_sha256"],
      "properties": {
        "candidate_code": { "enum": ["A", "B"] },
        "common_inputs": { "$ref": "#/definitions/commonInputs" },
        "attempt_statuses": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": { "enum": ["valid", "discarded", "failed", "inconclusive"] }
        },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/metric" } },
        "soak": { "$ref": "#/definitions/soak" },
        "artifact_sha256": { "$ref": "#/definitions/sha256" },
        "toolchain_bundle_sha256": { "$ref": "#/definitions/sha256" },
        "lockfile_bundle_sha256": { "$ref": "#/definitions/sha256" },
        "runs_manifest_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "evidenceHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_ordinal", "run_id", "candidate_code", "attempt", "status", "raw_sha256", "raw_final_line_sha256", "run_record_sha256", "snapshot_sha256"],
      "properties": {
        "snapshot_ordinal": { "type": "integer", "minimum": 1, "maximum": 44 },
        "run_id": { "type": "string", "pattern": "^run-[AB]-[a-z0-9][a-z0-9._-]{0,121}$" },
        "candidate_code": { "enum": ["A", "B"] },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 22 },
        "status": { "enum": ["valid", "discarded", "failed", "inconclusive"] },
        "raw_sha256": { "$ref": "#/definitions/sha256" },
        "raw_final_line_sha256": { "$ref": "#/definitions/sha256" },
        "run_record_sha256": { "$ref": "#/definitions/sha256" },
        "snapshot_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "traceHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_code", "run_id", "trace_id", "sha256"],
      "properties": {
        "candidate_code": { "enum": ["A", "B"] },
        "run_id": { "type": "string", "pattern": "^run-[AB]-[a-z0-9][a-z0-9._-]{0,121}$" },
        "trace_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
