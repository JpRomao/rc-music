{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M0 deterministic real-codec fixture recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "recipe_id",
    "generator",
    "network_allowed",
    "ambient_tool_lookup_allowed",
    "tools",
    "source_signal",
    "metadata",
    "common_encoding_arguments",
    "probe_arguments",
    "decode_hash_arguments",
    "actions"
  ],
  "properties": {
    "schema_id": { "const": "m0.audio-codec-recipe.v1" },
    "schema_version": { "const": 1 },
    "recipe_id": { "const": "M0-AUDIO-CODEC-RECIPE-1" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes", "runtime"],
      "properties": {
        "relative_path": { "const": "scripts/m0/New-M0AudioCodecFixtures.ps1" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "runtime": { "const": "PowerShell 7.6.5" }
      }
    },
    "network_allowed": { "const": false },
    "ambient_tool_lookup_allowed": { "const": false },
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/tool" }
    },
    "source_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expression",
        "left_frequency_hz",
        "right_frequency_hz",
        "amplitude",
        "sample_rate_hz",
        "channels",
        "bits_per_sample",
        "sample_count_per_channel",
        "duration_ms",
        "expected_size_bytes",
        "expected_sha256",
        "generation_arguments"
      ],
      "properties": {
        "kind": { "const": "lavfi_aevalsrc_sine_pair" },
        "expression": { "const": "aevalsrc=0.125*sin(2*PI*440*t)|0.125*sin(2*PI*660*t):s=48000:d=2:c=stereo" },
        "left_frequency_hz": { "const": 440 },
        "right_frequency_hz": { "const": 660 },
        "amplitude": { "const": 0.125 },
        "sample_rate_hz": { "const": 48000 },
        "channels": { "const": 2 },
        "bits_per_sample": { "const": 16 },
        "sample_count_per_channel": { "const": 96000 },
        "duration_ms": { "const": 2000 },
        "expected_size_bytes": { "const": 384044 },
        "expected_sha256": { "const": "249a7a355a3c84b5a8d2de3737b637a27b5e3be59a3ff0b6e5bb6ff7e43753a8" },
        "generation_arguments": { "$ref": "#/definitions/arguments" }
      }
    },
    "metadata": { "$ref": "#/definitions/exact_tags" },
    "common_encoding_arguments": { "$ref": "#/definitions/arguments" },
    "probe_arguments": { "$ref": "#/definitions/arguments" },
    "decode_hash_arguments": { "$ref": "#/definitions/arguments" },
    "actions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "status",
          "output_relative_path",
          "codec_and_profile",
          "bitrate_mode",
          "codec_arguments"
        ],
        "properties": {
          "fixture_id": {
            "enum": [
              "mp3-cbr-stereo",
              "mp3-vbr-stereo",
              "mp3-unicode-tags",
              "m4a-aac-lc",
              "flac-16-stereo",
              "ogg-vorbis",
              "opus-candidate",
              "m4a-alac-candidate"
            ]
          },
          "status": { "enum": ["valid", "candidate"] },
          "output_relative_path": {
            "type": "string",
            "pattern": "^fixtures/(?:valid|candidate)/[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:mp3|m4a|flac|ogg|opus)$"
          },
          "codec_and_profile": { "type": "string", "minLength": 1 },
          "bitrate_mode": { "enum": ["constant", "variable", "lossless"] },
          "codec_arguments": { "$ref": "#/definitions/arguments" }
        }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "exact_tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "artist", "album", "comment", "date"],
      "properties": {
        "title": { "const": "Canção determinística 日本語 🎵" },
        "artist": { "const": "João – Codex" },
        "album": { "const": "Álbum de teste Ω" },
        "comment": { "const": "fixture local • 2026-08-29" },
        "date": { "const": "2026-08-29" }
      }
    },
    "tool": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_id", "version_line", "size_bytes", "sha256", "usage_scope"],
          "properties": {
            "tool_id": { "const": "ffmpeg" },
            "version_line": { "const": "ffmpeg version 8.1.1-full_build-www.gyan.dev Copyright (c) 2000-2026 the FFmpeg developers" },
            "size_bytes": { "const": 227398656 },
            "sha256": { "const": "09948d4cdd0650da6ff5a87577469f2a218dc2615ae379f8f734d24c49de0f73" },
            "usage_scope": { "const": "fixture-generation-only; never runtime or packaged" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_id", "version_line", "size_bytes", "sha256", "usage_scope"],
          "properties": {
            "tool_id": { "const": "ffprobe" },
            "version_line": { "const": "ffprobe version 8.1.1-full_build-www.gyan.dev Copyright (c) 2007-2026 the FFmpeg developers" },
            "size_bytes": { "const": 227193344 },
            "sha256": { "const": "a6618e99bb58869ded3c6f37b53aa1a8d701c3591dbb7b5b317d47369c112be2" },
            "usage_scope": { "const": "fixture-generation-only; never runtime or packaged" }
          }
        }
      ]
    }
  }
}
